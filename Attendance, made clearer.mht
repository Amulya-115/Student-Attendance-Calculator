@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");

:root { color-scheme: light; --ink: #24334f; --muted: #74819a; --blue: #5379d7; --blue-deep: #3e61bd; --blue-soft: #eaf0ff; --lavender: #f1edff; --lavender-ink: #7867bd; --mint: #e4f4ed; --mint-ink: #34785d; --rose: #fff0ed; --rose-ink: #b75c55; --paper: #f5f7fc; --surface: #fff; --line: #e8ecf4; --shadow: 0 14px 38px rgba(47, 66, 108, .075); font-family: "DM Sans", sans-serif; color: var(--ink); background: var(--paper); font-synthesis: none; }

* { box-sizing: border-box; }

body { margin: 0px; min-width: 320px; min-height: 100vh; background: radial-gradient(ellipse at 84% 0%,#eeedff 0,transparent 29rem),var(--paper); }

button, input { font: inherit; }

button { cursor: pointer; }

button:focus-visible, input:focus-visible { outline: rgba(83, 121, 215, 0.3) solid 3px; outline-offset: 2px; }

.app-shell { width: min(1160px, 100% - 48px); margin: 0px auto; padding: 27px 0px 60px; }

.topbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 35px; }

.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }

.brand-mark { display: grid; place-items: center; width: 44px; height: 44px; color: rgb(255, 255, 255); background: var(--blue); border-radius: 15px; box-shadow: rgba(83, 121, 215, 0.2) 0px 7px 15px; }

.brand-mark svg { width: 25px; height: 25px; }

.brand-name { font: 800 15px / 1.15 Manrope, sans-serif; letter-spacing: -0.035em; }

.brand-sub { display: block; margin-top: 4px; color: var(--muted); font-size: 11px; font-weight: 500; letter-spacing: 0.035em; }

.date-chip { color: rgb(101, 114, 140); background: rgba(255, 255, 255, 0.78); padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: 12px; }

.intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; margin-bottom: 27px; }

.eyebrow { color: var(--blue); text-transform: uppercase; font-size: 10px; font-weight: 700; letter-spacing: 0.15em; margin: 0px 0px 10px; }

h1, h2, h3, p { margin-top: 0px; }

h1 { margin-bottom: 8px; font: 800 clamp(28px, 4vw, 40px) / 1.12 Manrope, sans-serif; letter-spacing: -0.055em; }

.intro-copy { margin: 0px; color: var(--muted); font-size: 14px; }

.student-field { width: min(235px, 32%); flex-shrink: 0; }

.field-label { display: block; color: rgb(89, 103, 128); font-size: 11px; font-weight: 700; margin-bottom: 7px; }

.input { width: 100%; height: 44px; color: var(--ink); background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 0px 13px; transition: border-color 0.18s, box-shadow 0.18s; }

.input::placeholder { color: rgb(160, 170, 190); }

.input:focus { border-color: rgb(147, 169, 232); box-shadow: rgba(83, 121, 215, 0.09) 0px 0px 0px 3px; outline: none; }

.dashboard-grid { display: grid; grid-template-columns: minmax(0px, 1.18fr) minmax(340px, 0.82fr); gap: 20px; align-items: stretch; }

.panel { background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(227, 232, 243, 0.9); border-radius: 22px; box-shadow: var(--shadow); }

.calculator { padding: 25px; }

.panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 15px; margin-bottom: 21px; }

.panel-heading h2 { margin: 0px 0px 5px; font: 800 19px / 1.2 Manrope, sans-serif; letter-spacing: -0.035em; }

.panel-heading p { margin: 0px; color: var(--muted); font-size: 12px; }

.tiny-cap { display: grid; place-items: center; width: 38px; height: 38px; color: var(--lavender-ink); background: var(--lavender); border-radius: 13px; }

.tiny-cap svg { width: 21px; height: 21px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 14px; }

.field.full { grid-column: 1 / -1; }

.suffix-wrap { position: relative; }

.suffix-wrap .input { padding-right: 43px; }

.suffix { position: absolute; right: 13px; top: 50%; transform: translateY(-50%); color: rgb(139, 150, 170); font-size: 12px; pointer-events: none; }

.button-row { display: flex; gap: 10px; margin-top: 20px; }

.btn { display: inline-flex; justify-content: center; align-items: center; min-height: 42px; gap: 8px; border: 0px; border-radius: 12px; padding: 0px 17px; font-size: 12px; font-weight: 700; transition: transform 0.18s, background 0.18s, box-shadow 0.18s; }

.btn:hover { transform: translateY(-1px); }

.btn:active { transform: translateY(0px); }

.btn-primary { color: rgb(255, 255, 255); background: var(--blue); box-shadow: rgba(83, 121, 215, 0.18) 0px 6px 13px; }

.btn-primary:hover { background: var(--blue-deep); }

.btn-quiet { color: rgb(105, 118, 144); background: rgb(242, 244, 249); }

.btn-quiet:hover { background: rgb(233, 237, 245); }

.btn svg { width: 15px; height: 15px; }

.form-message { min-height: 18px; margin: 12px 0px 0px; color: var(--rose-ink); font-size: 11px; }

.results { padding: 25px; position: relative; overflow: hidden; background: linear-gradient(145deg, rgb(255, 255, 255) 15%, rgb(245, 243, 255)); }

.results::after { content: ""; width: 190px; height: 190px; position: absolute; right: -92px; top: -105px; border: 1px solid rgba(120, 103, 189, 0.1); border-radius: 50%; box-shadow: rgba(120, 103, 189, 0.024) 0px 0px 0px 20px, rgba(120, 103, 189, 0.02) 0px 0px 0px 42px; pointer-events: none; }

.result-top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; }

.result-top h2 { margin: 0px; font: 800 18px Manrope, sans-serif; letter-spacing: -0.03em; }

.status-pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 99px; padding: 7px 10px; color: var(--muted); background: rgb(240, 242, 247); font-size: 10px; font-weight: 700; white-space: nowrap; }

.status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: rgb(155, 165, 183); }

.status-pill.good { color: var(--mint-ink); background: var(--mint); }

.status-pill.good::before { background: rgb(86, 167, 125); }

.status-pill.warn { color: var(--rose-ink); background: var(--rose); }

.status-pill.warn::before { background: rgb(213, 123, 112); }

.rate-wrap { display: flex; align-items: center; gap: 17px; margin: 24px 0px 18px; }

.rate-ring { --rate: 0%; position: relative; width: 102px; height: 102px; flex: 0 0 102px; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--blue) var(--rate),#e8eafa 0); }

.rate-ring::before { content: ""; position: absolute; inset: 7px; border-radius: 50%; background: rgb(251, 250, 255); }

.rate-ring > span { z-index: 1; font: 800 23px Manrope, sans-serif; letter-spacing: -0.06em; }

.rate-copy strong { display: block; margin-bottom: 5px; font: 800 15px Manrope, sans-serif; }

.rate-copy p { margin: 0px; max-width: 195px; color: var(--muted); font-size: 11px; line-height: 1.5; }

.main-progress { margin: 16px 0px; }

.progress-label { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 7px; color: rgb(120, 132, 155); font-size: 10px; font-weight: 600; }

.progress-label span:last-child { color: var(--ink); font-weight: 800; }

.progress-track { height: 8px; overflow: hidden; border-radius: 99px; background: rgb(232, 234, 250); }

.progress-fill { width: 0px; height: 100%; border-radius: inherit; background: var(--blue); transition: width 0.35s, background 0.2s; }

.results[data-status="good"] .progress-fill { background: rgb(86, 167, 125); }

.results[data-status="warn"] .progress-fill { background: rgb(213, 123, 112); }

.results[data-status="good"] .rate-ring { background: conic-gradient(#56a77d var(--rate),#e8f4ed 0); }

.results[data-status="warn"] .rate-ring { background: conic-gradient(#d57b70 var(--rate),#fae8e5 0); }

.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }

.stat { border-radius: 13px; padding: 11px 10px; background: rgba(255, 255, 255, 0.8); border: 1px solid rgb(236, 236, 245); }

.stat-label { display: block; color: var(--muted); font-size: 10px; margin-bottom: 4px; }

.stat-value { font: 800 17px Manrope, sans-serif; }

.smart-metrics { display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 8px; margin-top: 12px; }

.smart-metric { min-width: 0px; padding: 11px; border: 1px solid rgb(236, 236, 245); border-radius: 13px; background: rgba(255, 255, 255, 0.8); }

.smart-label { display: block; min-height: 28px; color: var(--muted); font-size: 10px; line-height: 1.4; }

.smart-metric strong { display: block; margin: 4px 0px; color: var(--ink); font: 800 17px / 1.2 Manrope, sans-serif; overflow-wrap: anywhere; }

.smart-metric small { display: block; color: rgb(132, 144, 165); font-size: 9px; line-height: 1.45; }

.plan-box { margin-top: 14px; background: rgb(237, 242, 255); border-radius: 14px; padding: 14px 15px; color: rgb(63, 88, 151); }

.plan-title { display: flex; align-items: center; gap: 7px; margin-bottom: 5px; font-size: 11px; font-weight: 800; }

.plan-title svg { width: 15px; height: 15px; }

.plan-text { margin: 0px; font-size: 11px; line-height: 1.55; color: rgb(88, 109, 159); }

.formula { margin: 16px 0px 0px; color: rgb(137, 147, 167); font-size: 10px; line-height: 1.5; }

.formula strong { color: rgb(102, 115, 140); }

.subjects-section { margin-top: 36px; }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 15px; }

.heading-actions { display: flex; align-items: center; gap: 9px; }

.add-subject { min-height: 38px; padding: 0px 13px; }

.section-heading h2 { margin: 0px 0px 5px; font: 800 21px Manrope, sans-serif; letter-spacing: -0.04em; }

.section-heading p { margin: 0px; font-size: 12px; color: var(--muted); }

.overall-chip { display: flex; align-items: center; gap: 8px; color: rgb(102, 115, 141); border: 1px solid var(--line); background: rgb(255, 255, 255); border-radius: 99px; padding: 9px 13px; font-size: 11px; }

.overall-chip strong { color: var(--blue-deep); font: 800 13px Manrope, sans-serif; }

.subject-form { display: none; margin-bottom: 15px; padding: 19px; }

.subject-form.open { display: block; animation: 0.2s ease-out 0s 1 normal none running rise; }

.subject-form h3 { font: 800 15px Manrope, sans-serif; margin-bottom: 16px; }

.subject-fields { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 12px; align-items: end; }

.subject-actions { display: flex; gap: 8px; margin-top: 15px; justify-content: flex-end; }

.subjects-list { display: grid; gap: 11px; }

.subject-card { display: grid; grid-template-columns: minmax(180px, 1.2fr) minmax(100px, 0.7fr) minmax(150px, 1fr) auto; gap: 15px; align-items: center; padding: 17px 19px; transition: transform 0.18s, box-shadow 0.18s; }

.subject-card:hover { transform: translateY(-2px); box-shadow: rgba(47, 66, 108, 0.09) 0px 14px 30px; }

.subject-name { font: 800 13px Manrope, sans-serif; margin-bottom: 4px; }

.subject-meta { color: var(--muted); font-size: 10px; }

.subject-percent { font: 800 20px Manrope, sans-serif; letter-spacing: -0.04em; }

.subject-percent small { display: block; margin-top: 3px; color: var(--muted); font: 500 10px "DM Sans", sans-serif; letter-spacing: 0px; }

.mini-track { height: 7px; overflow: hidden; border-radius: 99px; background: rgb(237, 240, 247); margin-bottom: 6px; }

.mini-fill { height: 100%; width: var(--width); background: var(--blue); border-radius: inherit; transition: width 0.3s; }

.subject-progress small { color: var(--muted); font-size: 10px; }

.subject-tools { display: flex; align-items: center; gap: 7px; }

.icon-btn { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--line); color: rgb(123, 135, 156); background: rgb(255, 255, 255); border-radius: 10px; transition: background 0.18s, color 0.18s; }

.icon-btn:hover { color: var(--blue-deep); background: var(--blue-soft); }

.icon-btn.delete:hover { color: var(--rose-ink); background: var(--rose); }

.icon-btn svg { width: 15px; height: 15px; }

.empty-state { padding: 35px 20px; text-align: center; border: 1px dashed rgb(212, 220, 238); background: rgba(255, 255, 255, 0.62); border-radius: 20px; }

.empty-illustration { width: 52px; height: 52px; margin: 0px auto 13px; display: grid; place-items: center; border-radius: 17px; color: var(--lavender-ink); background: var(--lavender); }

.empty-illustration svg { width: 26px; height: 26px; }

.empty-state h3 { margin: 0px 0px 6px; font: 800 15px Manrope, sans-serif; }

.empty-state p { margin: 0px auto 16px; max-width: 350px; color: var(--muted); font-size: 12px; line-height: 1.55; }

.footer-note { display: flex; justify-content: center; gap: 7px; margin-top: 30px; color: rgb(154, 164, 182); font-size: 10px; text-align: center; }

.footer-note svg { width: 13px; height: 13px; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0px; margin: -1px; overflow: hidden; clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border: 0px; }

@keyframes rise { 
  0% { opacity: 0; transform: translateY(5px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (max-width: 820px) {
  .dashboard-grid { grid-template-columns: 1fr; }
  .subject-fields { grid-template-columns: 1fr 1fr; }
  .subject-card { grid-template-columns: 1.1fr 0.6fr 1fr auto; gap: 10px; padding: 15px; }
}

@media (max-width: 560px) {
  .app-shell { width: min(100% - 30px, 500px); padding-top: 18px; }
  .topbar { margin-bottom: 27px; }
  .date-chip { display: none; }
  .intro { display: block; margin-bottom: 21px; }
  .student-field { width: 100%; margin-top: 17px; }
  h1 { font-size: 31px; }
  .calculator, .results { padding: 19px; border-radius: 19px; }
  .form-grid { gap: 13px 10px; }
  .field-label { font-size: 10px; }
  .input { height: 42px; padding-left: 11px; }
  .button-row .btn { flex: 1 1 0%; }
  .rate-wrap { gap: 13px; }
  .rate-ring { width: 88px; height: 88px; flex-basis: 88px; }
  .rate-ring > span { font-size: 20px; }
  .stat { padding: 9px 8px; }
  .stat-value { font-size: 15px; }
  .section-heading { align-items: flex-start; flex-direction: column; }
  .heading-actions { width: 100%; justify-content: space-between; }
  .subject-fields { grid-template-columns: 1fr 1fr; }
  .subject-fields .field:first-child { grid-column: 1 / -1; }
  .subject-card { grid-template-columns: 1fr auto; }
  .subject-percent { grid-area: 2 / 1; }
  .subject-progress { grid-area: 3 / 1 / auto / -1; }
  .subject-tools { grid-area: 1 / 2 / span 2; align-self: center; }
  .overall-chip { padding: 8px 11px; }
}

@media (max-width: 370px) {
  .smart-metrics { grid-template-columns: 1fr; }
  .smart-label { min-height: 0px; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}
