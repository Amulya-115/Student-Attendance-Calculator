<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f7fc">
    <meta name="description" content="A friendly attendance companion to help you understand your numbers and plan your next classes.">
    <title>Attendance, made clearer</title>
    <link rel="icon" type="image/x-icon" href="https://attend-ease-dashboard--kallurinarayana.replit.app/attendance-calculator/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="https://attend-ease-dashboard--kallurinarayana.replit.app/attendance-calculator/favicon.svg">
    
    <link rel="stylesheet" crossorigin="" href="https://attend-ease-dashboard--kallurinarayana.replit.app/attendance-calculator/assets/index-DsI8CjNu.css">
  </head>
  <body>
    <main class="app-shell">
      <header class="topbar">
        <a class="brand" href="https://attend-ease-dashboard--kallurinarayana.replit.app/attendance-calculator/" aria-label="Attendance, made clearer home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="m2.8 9.1 9.2-4.4 9.2 4.4-9.2 4.4-9.2-4.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M6.5 11v4.3c3.6 2.8 7.4 2.8 11 0V11M21.2 9.2v5.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="21.2" cy="16.2" r="1.2" fill="currentColor"></circle></svg>
          </span>
          <span class="brand-name">Classmate<span class="brand-sub">YOUR ATTENDANCE COMPANION</span></span>
        </a>
        <div class="date-chip" id="today-label" aria-label="Today's date"></div>
      </header>

      <section class="intro" aria-labelledby="welcome-heading">
        <div>
          <p class="eyebrow">A little clarity goes a long way</p>
          <h1 id="welcome-heading">Your attendance,<br>at a glance.</h1>
          <p class="intro-copy">Know where you stand. Make a plan that feels doable.</p>
        </div>
        <div class="student-field">
          <label class="field-label" for="student-name">Your name <span>(optional)</span></label>
          <input class="input" id="student-name" type="text" maxlength="60" placeholder="e.g. Maya">
        </div>
      </section>

      <section class="dashboard-grid" aria-label="Attendance calculator">
        <form class="panel calculator" id="calculator-form" novalidate="">
          <div class="panel-heading">
            <div>
              <h2>Check a class</h2>
              <p>Enter your counts and see what comes next.</p>
            </div>
            <span class="tiny-cap" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m2.8 9.1 9.2-4.4 9.2 4.4-9.2 4.4-9.2-4.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M6.5 11v4.3c3.6 2.8 7.4 2.8 11 0V11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></span>
          </div>
          <div class="form-grid">
            <div class="field full">
              <label class="field-label" for="class-name">Subject name <span>(optional)</span></label>
              <input class="input" id="class-name" type="text" maxlength="80" placeholder="e.g. Introduction to Biology">
            </div>
            <div class="field">
              <label class="field-label" for="total-classes">Classes conducted</label>
              <input class="input" id="total-classes" type="number" min="0" step="1" inputmode="numeric" placeholder="0" required="">
            </div>
            <div class="field">
              <label class="field-label" for="attended-classes">Classes attended</label>
              <input class="input" id="attended-classes" type="number" min="0" step="1" inputmode="numeric" placeholder="0" required="">
            </div>
            <div class="field full">
              <label class="field-label" for="required-rate">Required attendance</label>
              <div class="suffix-wrap">
                <input class="input" id="required-rate" type="number" min="0" max="100" step="any" inputmode="decimal" value="75" required="">
                <span class="suffix">%</span>
              </div>
            </div>
          </div>
          <div class="button-row">
            <button class="btn btn-primary" type="submit">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 3 4 13h6l-1 8 11-12h-7l1-6h-3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
              Calculate
            </button>
            <button class="btn btn-quiet" type="reset" id="reset-calculator">Reset</button>
          </div>
          <p class="form-message" id="calculator-message" aria-live="polite"></p>
        </form>

        <section class="panel results" id="result-panel" aria-labelledby="result-heading" aria-live="polite">
          <div class="result-top">
            <div>
              <p class="eyebrow" id="result-subject">YOUR SNAPSHOT</p>
              <h2 id="result-heading">Attendance snapshot</h2>
            </div>
            <span class="status-pill" id="status-pill">Not started</span>
          </div>
          <div class="rate-wrap">
            <div class="rate-ring" id="rate-ring" role="img" aria-label="Attendance rate 0 percent"><span id="rate-value">—</span></div>
            <div class="rate-copy">
              <strong id="result-message">Ready when you are</strong>
              <p id="result-summary">Add your class counts to see your current attendance and a practical next step.</p>
            </div>
          </div>
          <div class="main-progress">
            <div class="progress-label"><span>Attendance progress</span><span id="progress-value">0%</span></div>
            <div class="progress-track" id="attendance-progress" role="progressbar" aria-label="Attendance percentage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="No classes recorded">
              <div class="progress-fill" id="attendance-progress-fill"></div>
            </div>
          </div>
          <div class="stats" aria-label="Attendance counts">
            <div class="stat"><span class="stat-label">Attended</span><span class="stat-value" id="stat-attended">0</span></div>
            <div class="stat"><span class="stat-label">Conducted</span><span class="stat-value" id="stat-conducted">0</span></div>
            <div class="stat"><span class="stat-label">Missed</span><span class="stat-value" id="stat-missed">0</span></div>
          </div>
          <div class="smart-metrics" aria-label="Smart attendance calculations">
            <div class="smart-metric">
              <span class="smart-label">Classes to reach target</span>
              <strong id="classes-needed">—</strong>
              <small id="needed-caption">Calculate to see your next step.</small>
            </div>
            <div class="smart-metric">
              <span class="smart-label">Safe consecutive misses</span>
              <strong id="safe-misses">—</strong>
              <small id="misses-caption">Calculate to see your attendance cushion.</small>
            </div>
          </div>
          <div class="plan-box">
            <div class="plan-title"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1m-8.6 8.6-2.1 2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"></circle></svg><span id="plan-heading">Your next step</span></div>
            <p class="plan-text" id="plan-text">Your attendance plan will appear here.</p>
          </div>
          <p class="formula"><strong>The math:</strong> attendance = attended ÷ conducted × 100. Your target is <span id="target-display">75%</span>.</p>
        </section>
      </section>

      <section class="subjects-section" aria-labelledby="subjects-heading">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Keep your semester in view</p>
            <h2 id="subjects-heading">Your subjects</h2>
            <p>Track each class and see your weighted overall rate.</p>
          </div>
          <div class="heading-actions">
            <div class="overall-chip" id="overall-chip"><span>Overall</span><strong id="overall-rate">—</strong></div>
            <button class="btn btn-primary add-subject" id="add-subject" type="button">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path></svg>
              Add subject
            </button>
          </div>
        </div>
        <form class="panel subject-form" id="subject-form" novalidate="">
          <h3 id="subject-form-heading">Add a subject</h3>
          <div class="subject-fields">
            <div class="field">
              <label class="field-label" for="subject-name">Subject name</label>
              <input class="input" id="subject-name" type="text" maxlength="80" placeholder="e.g. Modern History" required="">
            </div>
            <div class="field">
              <label class="field-label" for="subject-total">Conducted</label>
              <input class="input" id="subject-total" type="number" min="0" step="1" inputmode="numeric" placeholder="0" required="">
            </div>
            <div class="field">
              <label class="field-label" for="subject-attended">Attended</label>
              <input class="input" id="subject-attended" type="number" min="0" step="1" inputmode="numeric" placeholder="0" required="">
            </div>
            <div class="field">
              <label class="field-label" for="subject-target">Required %</label>
              <input class="input" id="subject-target" type="number" min="0" max="100" step="any" value="75" required="">
            </div>
          </div>
          <p class="form-message" id="subject-message" aria-live="polite"></p>
          <div class="subject-actions">
            <button class="btn btn-quiet" id="cancel-subject" type="button">Cancel</button>
            <button class="btn btn-primary" id="save-subject" type="submit">Add subject</button>
          </div>
        </form>
        <div class="subjects-list" id="subjects-list" aria-live="polite"></div>
      </section>
      <footer class="footer-note"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.7 2.9 8.2 7 10 4.1-1.8 7-5.3 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>Your subjects stay on this device. Take it one class at a time.</footer>
    </main>
  

